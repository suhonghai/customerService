# =============================================================================
# W11 ERP Admin — 多环境 compose 编排变量模板
# 拷贝并替换 {env} 和 secrets,真部署 secrets 不进 git。
#
# 实际文件:.env.development / .env.test / .env.uat / .env.production
# 子项目自己的变量(JWT_SECRET / DATABASE_URL / CHROMA_URL 等)放子项目 .env.*
# =============================================================================

# 各环境共享的 compose 编排变量
COMPOSE_PROJECT_NAME=w11-erp-{env}
MYSQL_PORT=3306
CHROMA_PORT=8001
BACKEND_PORT=3001
FRONTEND_PORT=5173
AI_CS_PORT=9529

MYSQL_ROOT_PASSWORD=please-generate
MYSQL_USER=erp_user
MYSQL_PASSWORD=please-generate
MYSQL_DATABASE=erp_admin

BACKEND_BUILD_ENV=production
FRONTEND_BUILD_ENV=production
AI_CS_BUILD_ENV=production

# ============================================================
# AI Customer Service Demo (ai-cs-demo) 公共 URL
# ============================================================
# 客户端可达的 backend / chroma URL。开发/测试用 localhost,uat/production 用反代域名。
# 每个实际 .env.<env> 文件按本机端口或部署域名替换:
#   - development/test 用 http://localhost:${BACKEND_PORT} / ${CHROMA_PORT}
#   - uat/production 用 https://api.<domain> / https://chroma.<domain>
BACKEND_PUBLIC_URL={backend_public_url}
CHROMA_PUBLIC_URL={chroma_public_url}
NEXT_PUBLIC_BACKEND_URL={backend_public_url}
NEXT_PUBLIC_CHROMA_URL={chroma_public_url}

# =============================================================================
# W11 全栈共享凭证(2026-07-17 补)
# - APP_ENV: 与 BACKEND/FRONTEND/AI_CS_BUILD_ENV 同步的逻辑环境名,
#   docker-compose.{env}.yml 在 build args 用,值通常与 {env} 一致。
# - INTERNAL_TOKEN: ai-cs-demo / erp-admin-frontend 调 backend internal API
#   的共享凭证(>= 32 字符),必须与 erp-admin-backend/.env.{env} 的
#   INTERNAL_TOKEN 完全一致(ai-cs-demo 直接读,frontend 通过
#   VITE_INTERNAL_TOKEN 读)。dev 可本地固定;prod / uat 必须用
#   `openssl rand -hex 32` 重新生成,严禁复用 dev 值。
# 此为模板占位,实际值在 .env.{env} 中替换,{env} → development|test|uat|production。
# =============================================================================
APP_ENV={env}
INTERNAL_TOKEN=please-generate
# cs-round-030:Next.js 的 NEXT_PUBLIC_* 是 build-time 注入,不会自动从
# INTERNAL_TOKEN 派生。ai-cs-demo 浏览器内 WS 鉴权(realtime.gateway.ts:58)
# 显式读 NEXT_PUBLIC_INTERNAL_TOKEN,值必须与上方 INTERNAL_TOKEN 完全一致。
# 注:docker-compose.{env}.yml 当前不显式声明 env(各子包走自有 .env),
# 所以 ai-cs-demo/.env.{env} 必须**手动同步**这一行(从根 .env 拷值过去)。
NEXT_PUBLIC_INTERNAL_TOKEN=please-generate
