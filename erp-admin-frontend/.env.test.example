# =============================================================================
# erp-admin-frontend — test 环境模板(CI / 集成测试)
#
# 用途:
#   .env.test 被 .gitignore 排除,所以 fresh CI runner 上不存在。
#   .github/workflows/pr-e2e.yml 的 "Prepare sub-package .env.test" 步骤会在
#   缺失时自动 `cp .env.test.example .env.test`。
#
# VITE_* 是构建期常量,容器 build 时通过 BUILD_ENV=test 注入。
#
# ⚠️ 不要把真 secret 写进本文件(它入仓)。前端只走 INTERNAL_TOKEN 转发到后端,
#    test 环境用的是根 .env.test.example 里的 ci_internal_token_change_me。
# =============================================================================

# 反代目标:后端容器在 compose 网络里叫 erp-admin-backend:3001,但前端构建时
# 我们指向根 .env.test 暴露的 host 端口(BACKEND_PORT=3002),
# 让 nginx / Vite proxy 能从宿主机访问。
VITE_API_BASE_URL=/api
VITE_PROXY_TARGET=http://localhost:3002

VITE_APP_NAME=ERP Admin

# 必须与根 .env.test.example / erp-admin-backend/.env.test.example / ai-cs-demo/.env.test.example 一致
VITE_INTERNAL_TOKEN=ci_internal_token_change_me