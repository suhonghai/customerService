NODE_ENV=production
PORT=3001
DATABASE_URL=mysql://erp_user:f2d2238e4b0a6919cdea8d58f8e69070@mysql:3306/erp_admin
# 修 entrypoint.sh 漂移:默认是 w11-mysql/w11-chroma,实际 compose 服务名是 mysql/chroma
MYSQL_HOST=mysql
CHROMA_HOST=chroma

# ============================================================
# JWT 鉴权 — prod 模式(必须替换 SECRET + 启用 refresh 静默刷新)
#
# 标准 access/refresh 双 token 模式:
#   - access token(短):用户每次 API 调用都校验;1h 后过期
#   - refresh token(长):仅用于换新 access;7d 后过期需重新登录
#
# V11 设计:access 1h + refresh 7d + 前端静默刷新(待 plan 实施)
#   - ai-cs-demo 检测到 access 过期(10001/10002)→ 自动 POST /api/auth/refresh
#   - refresh token 存 httpOnly cookie,access token 不存(每次现取)
#
# SECRET 必须替换为 64 hex(openssl rand -hex 32 各 2 次)
# ============================================================
JWT_SECRET=e67960171645021bc7e2ef75e33036e4bc0cabc1a1aab7f8e22bf8206b27e9ed
JWT_REFRESH_SECRET=5ef3a43e74440ae26150518249002a70cabf107981bc1ed861276a5b023b839e
# 注意:JWT_EXPIRES_IN / JWT_REFRESH_EXPIRES_IN / LOG_LEVEL 已被 docker-compose.prod.yml
# 硬编码(access=3600, refresh=604800, LOG_LEVEL=warn)。这里改也无效,改 compose 文件统一维护。
JWT_EXPIRES_IN=3600
JWT_REFRESH_EXPIRES_IN=604800

AI_API_KEY_ENCRYPT_KEY=e10ab68ff091fd8c349cb5c6a635d3a07a219e28ad51dd6ebb83e02ac22fdb90
INTERNAL_TOKEN=6b5836a5461a5f14febc39423ed96ba05bc0703bcbe3a2bccc97078182066090
CHROMA_URL=http://w11-chroma:8000
CHROMA_COLLECTION=erp_faq

# ALLOWED_INTERNAL_IPS:容器间通过 service name 通信(Docker network 内部 IP),
# 这里是 docker bridge 网段;部署时根据实际网络调整
ALLOWED_INTERNAL_IPS=127.0.0.1,::1,172.16.0.0/12,10.0.0.0/8

# ALLOWED_ORIGINS:CORS 白名单,必须包含所有前端域名(用逗号分隔)
ALLOWED_ORIGINS=https://app.suhai.cn,https://chat.suhai.cn,https://api.suhai.cn

LOG_LEVEL=warn

# ============================================================
# 部署 checklist(deploy 前必须确认)
# ============================================================
# [ ] JWT_SECRET / JWT_REFRESH_SECRET 已用 openssl rand -hex 32 生成
# [ ] JWT_REFRESH_EXPIRES_IN 已设(否则 dev 7d 默认生效)
# [ ] AI_API_KEY_ENCRYPT_KEY 已替换(backend 用它加密 erp 配置里的 apiKey)
# [ ] INTERNAL_TOKEN 已替换 32+ chars
# [ ] DATABASE_URL 密码已替换
# [ ] ALLOWED_ORIGINS 已加 prod 域名
# [ ] ALLOWED_INTERNAL_IPS 已加 docker 网络段
# [ ] CHAT_MODEL / EMBED_MODEL 与 erp-admin 的 ai-config 记录一致
# [ ] LOG_LEVEL=warn(prod 不输出 debug,避免日志爆)