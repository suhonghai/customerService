NODE_ENV=development
PORT=3001
DATABASE_URL=mysql://USER:PASS@HOST:3306/erp_admin
JWT_SECRET=please-generate-with-crypto-randomBytes-32
JWT_REFRESH_SECRET=please-generate-with-crypto-randomBytes-32
JWT_EXPIRES_IN=7200
AI_API_KEY_ENCRYPT_KEY=please-generate-64-hex
INTERNAL_TOKEN=please-generate-32-chars-min
CHROMA_URL=http://localhost:8001
CHROMA_COLLECTION=erp_faq
ALLOWED_INTERNAL_IPS=127.0.0.1,::1
ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info

# ============================================================
# 必填(README 列出但模板原缺)
# ============================================================
JWT_REFRESH_EXPIRES_IN=604800          # 必填 - refresh token 过期秒数,默认 7d=604800(auth/constants.ts 读取)
DASHSCOPE_API_KEY=change_me            # 必填 - 阿里云 DashScope API key(Embedding 降级 fallback,后台无 active ai-config 时启用)
UPLOAD_DIR=/tmp/erp-admin-uploads      # 必填 - 文件上传本地存储目录(Common FileStorageModule 注入)

# ============================================================
# 可选(README 列出 / 代码实际读取但模板原缺)
# ============================================================
EMBED_MODEL=text-embedding-v4          # 可选 - Embedding 模型名,默认 text-embedding-v4(embedding.service.ts 读取)
DASHSCOPE_BASE_URL=                    # 可选 - Embedding baseURL,留空走默认 https://dashscope.aliyuncs.com/compatible-mode/v1