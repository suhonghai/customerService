# =============================================================================
# W11 ERP Admin — production 环境
# 5 服务全 docker,密码 CHANGE_ME_PROD 必须替换
# 用法: docker compose --env-file .env.production -f docker-compose.yml -f docker-compose.prod.yml -p ${COMPOSE_PROJECT_NAME} up -d
# =============================================================================

COMPOSE_PROJECT_NAME=w11-erp-prod
MYSQL_PORT=3306
CHROMA_PORT=8000
BACKEND_PORT=3001
FRONTEND_PORT=5173
# AI_CS_PORT 不设 → base 文件里 ${AI_CS_PORT:-}:9529 → 空字符串 → 不绑 host 端口
# (生产由 nginx 反代 chat.suhai.cn → ai-cs-demo:9529;只在 docker network 内访问)

MYSQL_ROOT_PASSWORD=7d3d1f6a98d558115863ff56331de6a1
MYSQL_USER=erp_user
MYSQL_PASSWORD=f2d2238e4b0a6919cdea8d58f8e69070
MYSQL_DATABASE=erp_admin

NODE_IMAGE=node:20-alpine

BACKEND_BUILD_ENV=production
FRONTEND_BUILD_ENV=production
AI_CS_BUILD_ENV=production

# 补齐:W11 CLAUDE.md 强制 INTERNAL_TOKEN 三处一致(根/后端/ai-cs-demo)
INTERNAL_TOKEN=6b5836a5461a5f14febc39423ed96ba05bc0703bcbe3a2bccc97078182066090
NEXT_PUBLIC_INTERNAL_TOKEN=6b5836a5461a5f14febc39423ed96ba05bc0703bcbe3a2bccc97078182066090
# 补 ai-cs-demo 客户端 build-time 烘焙:之前只有 NEXT_PUBLIC_BACKEND_URL,
# 但 src/lib/auth.ts / login/page.tsx 读的是 NEXT_PUBLIC_API_BASE_URL,差一名 drift。
# 客户端 fetch 拿空 → fallback '' → fetch 走相对路径 → 落到 :9529 → 404。
# 部署到本机 docker 走 localhost;真生产换域名。
NEXT_PUBLIC_API_BASE_URL=https://api.suhai.cn
NEXT_PUBLIC_CHROMA_URL=https://api.suhai.cn

# ============================================================
# AI Customer Service Demo (ai-cs-demo) — production 环境
# ============================================================
# 生产用域名,真实部署时填
BACKEND_PUBLIC_URL=https://api.suhai.cn
CHROMA_PUBLIC_URL=https://api.suhai.cn
NEXT_PUBLIC_BACKEND_URL=https://api.suhai.cn
NEXT_PUBLIC_CHROMA_URL=https://api.suhai.cn
