{
  "erp-admin-backend/src/**/*.{ts,tsx}": [
    "cd erp-admin-backend && pnpm exec eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings 0",
    "cd erp-admin-backend && pnpm exec prettier --write"
  ],
  "erp-admin-backend/test/**/*.{ts,tsx}": [
    "cd erp-admin-backend && pnpm exec eslint \"{src,apps,libs,test}/**/*.ts\" --fix --max-warnings 0",
    "cd erp-admin-backend && pnpm exec prettier --write"
  ],
  "erp-admin-backend/prisma/**/*.ts": [
    "cd erp-admin-backend && pnpm exec prettier --write"
  ],
  "erp-admin-frontend/src/**/*.{ts,tsx}": [
    "cd erp-admin-frontend && pnpm exec eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "cd erp-admin-frontend && pnpm exec prettier --write"
  ],
  "erp-admin-frontend/src/**/*.{css,json}": [
    "cd erp-admin-frontend && pnpm exec prettier --write"
  ],
  "ai-cs-demo/src/**/*.{ts,tsx}": [
    "cd ai-cs-demo && pnpm exec eslint --fix",
    "cd ai-cs-demo && pnpm exec prettier --write"
  ],
  "ai-cs-demo/src/**/*.{css,json}": [
    "cd ai-cs-demo && pnpm exec prettier --write"
  ],
  "**/*.{md,json}": ["prettier --write"]
}
