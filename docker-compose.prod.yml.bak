# =============================================================================
# W11 ERP Admin — production overlay (Ubuntu 24.04 部署版)
#
# 与原版差异(2026-08-11):
# 1. 后端 / 前端 / ai-cs-demo 不再暴露端口到 host(原 ${BACKEND_PORT} 等)
#    —— 由新增的 nginx 容器统一对外(80/443),其他服务只在 docker network 内访问
# 2. 新增 nginx 服务(反代 3 个子域):app.suhai.cn / chat.suhai.cn / api.suhai.cn
# 3. 新增 certbot 服务:首次启动申请 Let's Encrypt 证书,后续 cron 自动续期
# 4. 卷:
#    - /opt/w11-erp/ssl → 证书存放(主机 → nginx 容器)
#    - /var/www/certbot   → ACME challenge webroot(主机 → certbot 容器)
#
# 用法:make ENV=production up(deploy/install.sh 也会调这个组合)
# =============================================================================

services:
  mysql:
    expose:
      - "3306"
    # 生产不暴露 3306 到 host,只在 docker network 内访问

  chroma:
    ports:
      - "${CHROMA_PORT:-8000}:8000"
    # 2026-08-11 改:用户要求保留 8000 端口直连(后续调试 / 灌库用)
    # 安全注意:chroma 默认无鉴权,暴露到公网有数据被读风险;
    # 服务器侧必须用 ufw / 腾讯云防火墙限制源 IP(只允许你自己的办公 IP)

  erp-admin-backend:
    build:
      context: ./erp-admin-backend
      dockerfile: Dockerfile
      args:
        NODE_ENV: production
        BUILD_ENV: production
    image: w11-backend:production
    container_name: ${COMPOSE_PROJECT_NAME}-backend
    env_file:
      - ./erp-admin-backend/.env.production
    environment:
      NODE_ENV: production
      PORT: 3001
      DATABASE_URL: mysql://${MYSQL_USER}:${MYSQL_PASSWORD}@mysql:3306/${MYSQL_DATABASE}
      CHROMA_URL: http://chroma:8000
      JWT_EXPIRES_IN: "3600"
      JWT_REFRESH_EXPIRES_IN: "604800"
      LOG_LEVEL: "warn"
    expose:
      - "3001"
    # 注意:已删除 ports: "${BACKEND_PORT}:3001",后端不再直暴露
    depends_on:
      mysql:
        condition: service_healthy
      chroma:
        condition: service_healthy
    networks:
      - w11-net
    volumes:
      - backend_uploads:/data/uploads
      - backend_logs:/data/logs/erp-admin
    healthcheck:
      test: ["CMD", "curl", "-fsS", "http://127.0.0.1:3001/api/health/live"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 30s
    restart: always

  erp-admin-frontend:
    build:
      context: ./erp-admin-frontend
      dockerfile: Dockerfile
      args:
        BUILD_ENV: production
    image: w11-frontend:production
    container_name: ${COMPOSE_PROJECT_NAME}-frontend
    env_file:
      - ./erp-admin-frontend/.env.production
    expose:
      - "80"
    # 已删除 ports: "${FRONTEND_PORT}:80",前端容器端口 80 只在 docker network 内被 nginx 反代访问
    depends_on:
      - erp-admin-backend
    networks:
      - w11-net
    restart: always

  ai-cs-demo:
    build:
      context: ./ai-cs-demo
      dockerfile: Dockerfile
      args:
        APP_ENV: production
        # Next.js 客户端代码读 process.env.NEXT_PUBLIC_* 走 build-time 内联,
        # 必须烘焙正确的 https://api.suhai.cn,否则浏览器 fetch 走相对路径 404
        NEXT_PUBLIC_API_BASE_URL: ${NEXT_PUBLIC_API_BASE_URL:-https://api.suhai.cn}
        NEXT_PUBLIC_CHROMA_URL: ${NEXT_PUBLIC_CHROMA_URL:-https://api.suhai.cn}
        NEXT_PUBLIC_INTERNAL_TOKEN: ${NEXT_PUBLIC_INTERNAL_TOKEN:-}
    image: w11-ai-cs-demo:production
    container_name: ${COMPOSE_PROJECT_NAME}-ai-cs-demo
    env_file:
      - ./ai-cs-demo/.env.production
    environment:
      APP_ENV: production
      NODE_ENV: production
      PORT: 9529
      ERP_ADMIN_URL: http://erp-admin-backend:3001
      CHROMA_URL: http://chroma:8000
    # 2026-08-11:ai-cs-demo 在 prod 不暴露 host 端口
    # 通过 base docker-compose.yml 里 ports: "${AI_CS_PORT:-}:9529" 控制
    # prod .env.production 不设 AI_CS_PORT → 默认空 → 不绑 host
    # docker network 内通过 ai-cs-demo:9529 访问,由 nginx 反代给 chat.suhai.cn
    depends_on:
      - erp-admin-backend
      - chroma
    networks:
      - w11-net
    restart: always

  # =============================================================================
  # nginx 反代容器(2026-08-11 新增)
  # - 唯一对外暴露 80/443 的服务
  # - 反代规则见 deploy/nginx/prod.conf
  # - 证书由 certbot 服务首次启动后产生,挂 /opt/w11-erp/ssl:/etc/nginx/ssl:ro
  # =============================================================================
  nginx:
    image: nginx:stable-alpine
    container_name: ${COMPOSE_PROJECT_NAME}-nginx
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./deploy/nginx/prod.conf:/etc/nginx/conf.d/default.conf:ro
      - /opt/w11-erp/ssl:/etc/nginx/ssl:ro
      - /var/www/certbot:/var/www/certbot:ro
    depends_on:
      - erp-admin-backend
      - erp-admin-frontend
      - ai-cs-demo
    networks:
      - w11-net
    healthcheck:
      test: ["CMD", "wget", "-qO-", "http://127.0.0.1/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    restart: always

  # =============================================================================
  # certbot 容器(2026-08-11 新增)
  # - 首次启动:install.sh 调 `docker compose run --rm certbot certonly` 申请证书
  # - 续期:deploy/scripts/renew-ssl.sh 用 cron 每天跑(详情见 install.sh)
  # - ACME challenge webroot 在 /var/www/certbot,nginx .well-known 段反代到这
  # =============================================================================
  certbot:
    image: certbot/certbot:latest
    container_name: ${COMPOSE_PROJECT_NAME}-certbot
    volumes:
      - /opt/w11-erp/ssl:/etc/letsencrypt:rw
      - /var/www/certbot:/var/www/certbot:rw
    entrypoint: "/bin/sh -c 'trap exit TERM; while :; do sleep 86400; done'"
    networks:
      - w11-net
    restart: always

networks:
  w11-net:
    name: ${COMPOSE_PROJECT_NAME:-w11-erp}-net

volumes:
  backend_uploads:
    name: ${COMPOSE_PROJECT_NAME}-backend-uploads
  backend_logs:
    name: ${COMPOSE_PROJECT_NAME}-backend-logs