# =============================================================================
# W11 ERP Admin — test 环境模板(CI / 集成测试)
#
# 用途:
#   .env.test 被 .gitignore 排除,所以 fresh CI runner 上不存在。
#   .github/workflows/pr-e2e.yml 的 "Prepare .env.test" 步骤会在缺失时
#   自动 `cp .env.test.example .env.test`。
#
# 本地用法:
#   cp .env.test.example .env.test    # 然后按需改端口 / 密码
#
# 端口约定(与 .env.development / .env.uat / .env.production 错开,可并存):
#   test 环境统一用 +1 / +2 段:mysql 3308 / chroma 8002 / backend 3002
#   ⚠️ BACKEND_PORT 必须与 pr-e2e.yml 的健康探针 http://localhost:3002 一致
#
# ⚠️ 不要把真 secret 写进本文件(它入仓)。这里的密码仅用于 CI 里
#    临时起的 MySQL 容器,容器随 job 销毁。
# =============================================================================

COMPOSE_PROJECT_NAME=w11-erp-test
MYSQL_PORT=3308
CHROMA_PORT=8002
BACKEND_PORT=3002
FRONTEND_PORT=5174
AI_CS_PORT=9530

MYSQL_ROOT_PASSWORD=ci_root_pw_change_me
MYSQL_USER=erp_user
MYSQL_PASSWORD=ci_user_pw_change_me
MYSQL_DATABASE=erp_admin_test

# docker-compose.yml 里 ai-cs-demo 服务用 ${INTERNAL_TOKEN:?...} 声明为必填,
# 缺了会在 `make ENV=test up` 阶段直接中断(不是启动后才报错)。
# 按 CLAUDE.md 约束 2,INTERNAL_TOKEN 在 根 / 后端 / ai-cs-demo 三处必须一致 ——
# e2e 里后端由 `set -a && . ./.env.test` 启动,所以三处都取这里这一份值。
INTERNAL_TOKEN=ci_internal_token_change_me

NODE_IMAGE=node:20-alpine
NPM_REGISTRY=https://registry.npmmirror.com
PNPM_REGISTRY=https://registry.npmmirror.com

BACKEND_BUILD_ENV=test
FRONTEND_BUILD_ENV=test
AI_CS_BUILD_ENV=test

# docker-compose.yml line 60-61 用 ${APP_ENV:-production} 拼 env_file 路径,
# test 环境必须显式设成 test,否则 compose 兜底成 production 会去找不存在的
# ./ai-cs-demo/.env.production 而报错。
APP_ENV=test

# ============================================================
# AI Customer Service Demo (ai-cs-demo) — test 环境
# ============================================================
BACKEND_PUBLIC_URL=http://localhost:3002
CHROMA_PUBLIC_URL=http://localhost:8002
NEXT_PUBLIC_BACKEND_URL=http://localhost:3002
NEXT_PUBLIC_CHROMA_URL=http://localhost:8002
