# ====== 环境 ======
.env
.env.local
.env.*.local
# 多环境 compose 编排变量(2026-07-13 拆分)
.env.development
.env.test
.env.uat
.env.production
# .env.example 是模板,允许入仓

# ====== MySQL / Chroma 本地数据 ======
logs/
data/
chroma-data/
uploads/

# ====== Node ======
node_modules/
.pnp
.pnp.js

# ====== Build ======
dist/
build/
coverage/

# ====== Prisma ======
prisma/dev.db*
prisma/migrations/dev.db*

# ====== IDE ======
.vscode/
.idea/
*.swp
.DS_Store

# ====== Logs ======
*.log

# ====== Dev 进程运行时文件(scripts/dev-process.sh 生成,SkillHub PID 生命周期) ======
# logs/ 已整目录忽略;下面显式声明运行时 PID/日志意图,便于阅读。
# 只忽略 logs/ 下的运行时产物,不误伤 scripts/dev-process.sh 等源码。
logs/*.pid
*.pid
logs/dev-*.log

# ====== Test cache ======
.jest-cache/

# ====== Claude Code 本地覆盖(服务器凭证 / 私有约定) ======
# CLAUDE.local.md 是 Claude Code 官方约定的 local override 文件,
# 每次新开会话自动读取。绝不入仓(包含 SSH 密码等敏感信息)。
CLAUDE.local.md
CLAUDE.local.md.*

# ====== Husky 9 internal shim (auto-generated, do not commit) ======
.husky/_/

# ====== Claude Code 工作区(见 CLAUDE.md 「Worktree 隔离」段) ======
# CLAUDE.md 约定大改动走 `git worktree add .claude/worktrees/<branch>`。
# 这些 worktree 各自带一份 node_modules,2026-08-03 实测累计 2.0G —— 纯本地临时产物,永不入仓。
.claude/worktrees/
# 个人本地覆盖不入仓;.claude/settings.json 留空档:将来若要共享团队级配置,可以入仓。
.claude/settings.local.json

.playwright-mcp/
