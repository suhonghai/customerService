# =============================================================================
# ai-cs-demo — test 环境模板(CI / 集成测试)
#
# 用途:
#   .env.test 被 .gitignore 排除,所以 fresh CI runner 上不存在。
#   .github/workflows/pr-e2e.yml 的 "Prepare sub-package .env.test" 步骤会在
#   缺失时自动 `cp .env.test.example .env.test`。
#
# docker-compose.yml line 60 通过 env_file: ./ai-cs-demo/.env.${APP_ENV:-production}
# 加载本文件 —— APP_ENV 在根 .env.test 设成 test,所以这里必须叫 .env.test
# 才被 compose 解析到。
#
# docker-compose.test.yml line 81 也独立 env_file: ./ai-cs-demo/.env.test,
# 行为一致。
#
# 重要:compose 网络里 backend / chroma 通过服务名访问,不写 localhost。
#
# ⚠️ 不要把真 secret 写进本文件(它入仓)。
# =============================================================================

APP_ENV=test
NODE_ENV=test

# Server — V1 用 9530 避开 W9-10 9529(AI_CS_PORT 也用 9530 保持对齐)
PORT=9530

# Server-side:Next.js 服务端 → 后端容器(走 compose DNS 服务名)
ERP_ADMIN_URL=http://erp-admin-backend:3001
ERP_ADMIN_TOKEN=
ERP_ADMIN_INTERNAL_TOKEN=ci_internal_token_change_me

# 必须与根 / backend / frontend .env.test.example 一致
INTERNAL_TOKEN=ci_internal_token_change_me

# 浏览器可见,WS 握手用(必须与上面 INTERNAL_TOKEN 一致,#24 cs-round-007)
NEXT_PUBLIC_INTERNAL_TOKEN=ci_internal_token_change_me

# JWT — test 环境 ci 占位即可,与 backend 保持可识别但不真
JWT_SECRET=ci_jwt_secret_change_me

# AI models — test 不真发,但 service 启动时要能识别 model 名
CHAT_MODEL=qwen3.7-plus
EMBED_MODEL=text-embedding-v4

# Chroma — compose 网络服务名
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=v1_faq_test

# Auth (V1 S5 终端用户登录) — test 环境关闭真实登录触发
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=false

# Debug — test 环境全关
NEXT_PUBLIC_DEBUG_TRACE=false
NEXT_PUBLIC_DEBUG_RETRIEVAL=false
NEXT_PUBLIC_TOP_K=3

# Public API base(浏览器可见;test 默认指同源 / 反代后端)
NEXT_PUBLIC_API_BASE_URL=http://localhost:9530