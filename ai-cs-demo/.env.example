# V1 ai-cs-demo 环境变量模板(只 .env.example 进 git,其他 .env.* 不进)
# 拷贝本文件 → .env.{development|test|uat|production} 后填值
# 安装脚本 install.sh 会自动从 .env.v1 复制并生成

APP_ENV=development
NODE_ENV=development

# Server(本服务端口;V1 用 9530 避开 W9-10 9529)
PORT=9530

# Public API base(浏览器可见,V1 默认指向同源 / 反代后端)
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Server-side ERP Admin Backend(Next.js 服务端用,docker 网络内用服务名)
ERP_ADMIN_URL=http://erp-admin-backend:3001
ERP_ADMIN_TOKEN=
ERP_ADMIN_INTERNAL_TOKEN=
INTERNAL_TOKEN=

# JWT shared secret(必须与 erp-admin-backend .env.v1 一致,S3 设置)
JWT_SECRET=

# AI models
CHAT_MODEL=qwen3.7-plus
EMBED_MODEL=text-embedding-v4

# Chroma
CHROMA_URL=http://chroma:8000
CHROMA_COLLECTION=v1_faq

# Auth (V1 S5 终端用户登录)
# 启用手机号验证码登录(主)
# 注意:V1 后端 cs-auth 暂无 phone/code 端点,handler 永远返回「暂未开放」(见 #29)。
# 开关默认 false,UI 会隐藏入口;真要开请配套补后端 + rate-limit。
NEXT_PUBLIC_AUTH_PHONE_ENABLED=false
# 启用邮箱密码登录(辅)
NEXT_PUBLIC_AUTH_EMAIL_ENABLED=true

# Debug
NEXT_PUBLIC_DEBUG_TRACE=false
NEXT_PUBLIC_DEBUG_RETRIEVAL=false
NEXT_PUBLIC_TOP_K=3